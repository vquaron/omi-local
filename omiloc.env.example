# Private native Mac configuration. Prefer: bash scripts/local-mac.sh init-env
# That creates .env with mode 600 without replacing existing settings or keys.
OMI_LOCAL_TRANSPORT=tailscale
# Optional: verify this exact local Tailscale IPv4; empty means auto-discover.
OMI_TAILSCALE_IP=
# Generated on first setup. Preserve the existing key when changing transports.
OMI_LOCAL_APP_KEY=
# Optional ngrok settings, required only when OMI_LOCAL_TRANSPORT=ngrok.
# OMI_NGROK_URL=https://your-dev-domain.ngrok-free.app
# NGROK_AUTHTOKEN=
