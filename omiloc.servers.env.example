# Copy to .env.servers, chmod 600, then enter the existing server app keys.
# IDs stay stable across reinstalls. Names are labels; URL and key belong to
# the Omi recording server, not to its STT provider or ngrok account.
OMI_SERVER_home_NAME=Home Mac
OMI_SERVER_home_URL=100.64.0.1:20000
OMI_SERVER_home_KEY=replace-with-the-existing-43-character-app-key

# Uncomment all three fields for another server.
# OMI_SERVER_gpu_NAME=GPU server
# OMI_SERVER_gpu_URL=100.64.0.2:21000
# OMI_SERVER_gpu_KEY=replace-with-that-server-app-key
